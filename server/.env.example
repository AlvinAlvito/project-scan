# Salin menjadi .env lalu sesuaikan.
LJK_DB_URL=mysql+pymysql://root:root@localhost:3306/ljk_online?charset=utf8mb4
# Folder foto & hasil baca (default: server/data)
# LJK_DATA_DIR=D:/ljk-data
# Folder mesin pembaca yang berisi paket ljk/ (default: ../engine)
# LJK_ENGINE_PATH=../engine
# Folder tampilan web (default: ../web)
# LJK_WEB_DIR=../web
# Jumlah foto yang dibaca bersamaan
LJK_READ_WORKERS=2
LJK_MAX_UPLOAD_MB=25
# Penolakan foto buruk: ketajaman minimum (foto tajam ~175) & batas catatan pelurusan foto
LJK_MIN_SHARPNESS=45
LJK_MAX_PHOTO_NOTES=1
